# ═══════════════════════════════════════════════════════════════════════════
# AI Newsroom Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── General ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── LLM Provider Selection ───────────────────────────────────────────────
# Supported values: ollama, groq, gemini, nvidia
LLM_PROVIDER=ollama

# ── Ollama Configuration ─────────────────────────────────────────────────
# For local Ollama: http://localhost:11434
# For Docker (Ollama on host): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# ── Groq Configuration ───────────────────────────────────────────────────
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini Configuration ─────────────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── NVIDIA NIM Configuration ─────────────────────────────────────────────
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── Future: Database Connections (Phase 2+) ──────────────────────────────
# DATABASE_URL=postgresql://newsroom:newsroom_secret@localhost:5432/newsroom_db
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333
